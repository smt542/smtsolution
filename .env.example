NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_STAFF_EMAIL_DOMAIN=staff.gwanribiseo.app
# 서버 전용(발급 스크립트에서만). 절대 커밋/클라이언트 노출 금지:
SUPABASE_SERVICE_ROLE_KEY=

# 문자 실발송(NCP SENS) — 서버 전용. 설정 시 lib/messaging/ncp.ts 어댑터가 실발송,
# 미설정이면 기존 stub 유지(Track E: worker/포인트 예약·정산 배선 필요):
NCP_SENS_ACCESS_KEY=
NCP_SENS_SECRET_KEY=
NCP_SENS_SERVICE_ID=
NCP_SENS_CALLER_NUMBER=
# 선택(기본 https://sens.apigw.ntruss.com):
NCP_SENS_API_ENDPOINT=

# ── Popbill 통합 발송(SMS/LMS·알림톡·팩스) — 서버 전용 ──
# 미설정이면 실제 발송 경로가 PROVIDER_NOT_CONFIGURED로 명시적으로 실패한다(가짜 성공 없음).
# 절대 커밋/클라이언트(NEXT_PUBLIC_) 노출 금지.
POPBILL_LINK_ID=
POPBILL_SECRET_KEY=
# 운영사(파트너) 사업자번호 — 숫자만 저장(하이픈 무시):
POPBILL_CORP_NUM=
# 팝빌 담당자 아이디(선택):
POPBILL_USER_ID=
# 테스트/운영 구분 — 기본 true(테스트). 운영 전환 시 false 명시:
POPBILL_IS_TEST=true
# 연동회원 IP 제한(기본 true), 고정 IP 서버 사용(기본 false), 로컬시간 표기(기본 true):
POPBILL_IP_RESTRICT_ON=true
POPBILL_USE_STATIC_IP=false
POPBILL_USE_LOCAL_TIME=true
# 팝빌에 사전 등록·승인된 발신번호/카카오 채널:
POPBILL_SMS_SENDER=
POPBILL_KAKAO_SENDER=
POPBILL_FAX_SENDER=
