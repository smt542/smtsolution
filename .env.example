NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_STAFF_EMAIL_DOMAIN=staff.gwanribiseo.app
# Public resident-site origin used to build Alimtalk detail links (no trailing slash).
NEXT_PUBLIC_RESIDENT_WEB_ORIGIN=
# 서버 전용(발급 스크립트에서만). 절대 커밋/클라이언트 노출 금지:
SUPABASE_SERVICE_ROLE_KEY=

# Resident Kakao OAuth (server-only except the public UI switch).
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=
NEXT_PUBLIC_KAKAO_LOGIN_ENABLED=false

# ── Popbill 통합 발송(SMS/LMS·알림톡·팩스) — 서버 전용 ──
# 모든 외부 발송은 Popbill 하나로 통일한다(NCP 미사용). 미설정이면 실제 발송 경로가
# PROVIDER_NOT_CONFIGURED로 명시적으로 실패한다(가짜 성공 stub 없음).
# 절대 커밋/클라이언트(NEXT_PUBLIC_) 노출 금지.
POPBILL_LINK_ID=
POPBILL_SECRET_KEY=
# 운영사(파트너) 사업자번호 — 숫자만 저장(하이픈 무시):
POPBILL_CORP_NUM=
# 팝빌 담당자 아이디(선택):
POPBILL_USER_ID=
# 테스트/운영 구분 — 기본 true(테스트). 운영 전환 시 false 명시:
POPBILL_IS_TEST=true
# 연동회원 IP 제한(기본 true), 고정 IP 서버 사용(기본 false), 로컬시간 표기(기본 true):
POPBILL_IP_RESTRICT_ON=true
POPBILL_USE_STATIC_IP=false
POPBILL_USE_LOCAL_TIME=true
# 팝빌에 사전 등록·승인된 발신번호/카카오 채널:
#   - 알림톡: 카카오비즈니스 채널 개설·Popbill 등록·템플릿 승인이 선행되어야 발송된다(POPBILL_KAKAO_SENDER=카카오 채널/검색용 아이디).
#   - 카카오 주민 로그인용 Kakao Developers OAuth 앱은 이와 별개의 자격이다(이번 전환에 미포함).
POPBILL_SMS_SENDER=
POPBILL_KAKAO_SENDER=
POPBILL_FAX_SENDER=

# 예약 발송 워커·결과 재조회(/api/messaging/dispatch-scheduled, /api/delivery/reconcile) 인증용:
CRON_SECRET=
